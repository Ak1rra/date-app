# Date App environment. Copy to .env and fill in. Every secret comes from here
# (REQUIREMENTS §3, NFR-SEC-3). With DEMO_MODE=1 nothing below the "Providers"
# line is needed: fake providers and canned AI responses are used (NFR-QA-3, INT-1).

# --- Core -------------------------------------------------------------------
DEMO_MODE=1
# Public origin of the web app (used for CORS, magic-link URLs, cookies).
# This file is the local-dev template: http://localhost:8090 is the built app, use
# http://localhost:5173 for the Vite dev server. Production (https://dates.lan) sets
# APP_ORIGIN=https://dates.lan and COOKIE_SECURE=1 in a .env that lives only on the host.
APP_ORIGIN=http://localhost:8090
# Local dev only: exposes sign-in links over HTTP at /api/v1/dev/outbox, unauthenticated.
DEV_OUTBOX=0
# Port the app listens on (it serves the API and the built frontend).
PORT=8090
# Proxy addresses whose X-Forwarded-* headers are trusted (comma-separated, or *). Production
# behind Caddy on 192.168.1.164 sets FORWARDED_ALLOW_IPS=192.168.1.164.
FORWARDED_ALLOW_IPS=127.0.0.1
# Built frontend to serve. Empty = <repo>/frontend/dist.
FRONTEND_DIST=
# Run the background job worker inside the API process (0 to disable, e.g. for tests).
RUN_WORKER=1
# Async SQLAlchemy URL (native Postgres on the same machine).
DATABASE_URL=postgresql+asyncpg://dateapp:dateapp@localhost:5432/dateapp
# Used by the test suite (a separate database it may drop and recreate).
TEST_DATABASE_URL=postgresql+asyncpg://dateapp:dateapp@localhost:5432/dateapp_test
# 1 in production (https://dates.lan); 0 only for plain-http local dev.
COOKIE_SECURE=0
SESSION_TTL_DAYS=30
MAGIC_LINK_TTL_MINUTES=15
LOG_LEVEL=INFO
# Optional error tracking (NFR-REL-2).
SENTRY_DSN=

# --- Providers (not needed in DEMO_MODE) -----------------------------------
# LLM (AI-1, AI-2)
ANTHROPIC_API_KEY=
AI_MODEL_FAST=claude-haiku-5-5
AI_MODEL_SMART=claude-sonnet-5-5
# Google Maps Platform: Places API (New), Routes API, Geocoding API
GOOGLE_MAPS_API_KEY=
# Events
TICKETMASTER_API_KEY=
# Weather (Open-Meteo needs no key)
WEATHER_PROVIDER=open-meteo
# Transactional email for magic links (provider decided under REQUIREMENTS §14)
EMAIL_PROVIDER=console
EMAIL_API_KEY=
EMAIL_FROM=
# Web Push (VAPID)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=
# OAuth (FR-AUTH-2, SHOULD; not built yet)
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
