# Date App environment. Copy to .env and fill in. Every secret comes from here
# (REQUIREMENTS §3, NFR-SEC-3). With DEMO_MODE=1 nothing below the "Providers"
# line is needed: fake providers and canned AI responses are used (NFR-QA-3, INT-1).

# --- Core -------------------------------------------------------------------
DEMO_MODE=1
# Public origin of the web app (used for CORS, magic-link URLs, cookies).
APP_ORIGIN=http://localhost:8080
# Async SQLAlchemy URL. docker compose overrides the host to "db".
DATABASE_URL=postgresql+asyncpg://dateapp:dateapp@localhost:5432/dateapp
# Used by the test suite (a separate database it may drop and recreate).
TEST_DATABASE_URL=postgresql+asyncpg://dateapp:dateapp@localhost:5432/dateapp_test
POSTGRES_USER=dateapp
POSTGRES_PASSWORD=dateapp
POSTGRES_DB=dateapp
# Set to 0 only for plain-http local dev; must be 1 anywhere reachable by others.
COOKIE_SECURE=0
SESSION_TTL_DAYS=30
MAGIC_LINK_TTL_MINUTES=15
LOG_LEVEL=INFO
# Optional error tracking (NFR-REL-2).
SENTRY_DSN=

# --- Providers (not needed in DEMO_MODE) -----------------------------------
# LLM (AI-1, AI-2)
ANTHROPIC_API_KEY=
AI_MODEL_FAST=claude-haiku-5-5
AI_MODEL_SMART=claude-sonnet-5-5
# Google Maps Platform: Places API (New), Routes API, Geocoding API
GOOGLE_MAPS_API_KEY=
# Events
TICKETMASTER_API_KEY=
# Weather (Open-Meteo needs no key)
WEATHER_PROVIDER=open-meteo
# Transactional email for magic links (provider decided under REQUIREMENTS §14)
EMAIL_PROVIDER=console
EMAIL_API_KEY=
EMAIL_FROM=
# Web Push (VAPID)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=
# OAuth (FR-AUTH-2, SHOULD; not built yet)
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
