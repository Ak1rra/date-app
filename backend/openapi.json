        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/OutboxEntry"
                  },
                  "title": "Response Outbox Api V1 Dev Outbox Get",
                  "type": "array"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Outbox",
        "tags": [
          "dev"
        ]
      }
    },
    "/api/v1/health": {
      "get": {
